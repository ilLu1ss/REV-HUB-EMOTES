local searchCache = {}
local currentQuery = ""
local currentPage = 1
local pageCursors = { [1] = nil }
local isSearchRequestActive = false
local activeRequestSignature = ""
local searchCooldownUntil = 0


local function urlEncode(str)
    if not str then return "" end
    str = str:gsub("\n", "\r\n")
    str = str:gsub("([^%w %-%_%.%~])", function(c) return string.format("%%%02X", c:byte()) end)
    str = str:gsub(" ", "+")
    return str
end


-- search function
local function searchEmotes(query, cursor)
    local cleanQuery = query and query:match("^%s*(.-)%s*$"):lower() or ""

    if cleanQuery == "" then
        showNotification("Enter a term!", "warning")
        return
    end

    local now = os.clock()
    if now < searchCooldownUntil then
        return
    end
    searchCooldownUntil = now + 0.35

    local requestSignature = cleanQuery .. "|" .. tostring(cursor or "root") .. "|" .. tostring(currentPage)
    if isSearchRequestActive and requestSignature == activeRequestSignature then
        return
    end

    if not cursor then

        if cleanQuery == currentQuery and searchCache[cleanQuery .. "_1"] then
            currentPage = 1
            pageCursors = { [1] = nil }
        end

        if cleanQuery ~= currentQuery then
            showNotification("Searching: " .. cleanQuery, "search")
        end
        currentQuery = cleanQuery
        currentPage = 1
        pageCursors = { [1] = nil }
    end

    for _, child in ipairs(resultsContainer:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local cacheKey = cleanQuery .. "_" .. tostring(currentPage)
    local data = searchCache[cacheKey]

    if data then

        isSearchRequestActive = false
        activeRequestSignature = requestSignature
    else
        isSearchRequestActive = true
        activeRequestSignature = requestSignature

        local encoded = urlEncode(cleanQuery)
        local url = "https://catalog.roblox.com/v1/search/items?category=12&Subcategory=39&keyword=" ..
            encoded .. "&limit=10"
        if cursor then
            url = url .. "&cursor=" .. cursor
        end

        local ok, res = pcall(game.HttpGet, game, url)
        if not ok or not res then
            isSearchRequestActive = false
            return
        end

        data = HttpService:JSONDecode(res)
        searchCache[cacheKey] = data
        isSearchRequestActive = false
    end

    if not data or not data.data or #data.data == 0 then
        showNotification("No results", "warning")
        return
    end

    if data.nextPageCursor then
        pageCursors[currentPage + 1] = data.nextPageCursor
    else
        pageCursors[currentPage + 1] = nil
    end

    for _, item in ipairs(data.data) do
        local assetId = item.id

        local frame = UI.frame({
            Size = UDim2.new(1, 0, 0, 80),
            BgColor = colors.surface,
            CornerRadius = UDim.new(0, 10),
        }, resultsContainer)

        UI.create("ImageLabel", {
            Name = "Thumb",
            Size = UDim2.new(0, 60, 0, 60),
            Position = UDim2.new(0, 10, 0.5, -30),
            BackgroundColor3 = colors.surface2,
            BackgroundTransparency = 0.2,
            Image = "https://www.roblox.com/asset-thumbnail/image?assetId=" ..
                assetId .. "&width=150&height=150&format=png",
            CornerRadius = UDim.new(0, 8),
        }, frame)

        local nameLabel = UI.label({
            Name = "NameLabel",
            Size = UDim2.new(1, -180, 0, 25),
            Position = UDim2.new(0, 80, 0, 8),
            Text = "Loading...",
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextColor3 = colors.text,
        }, frame)

        UI.label({
            Name = "IdLabel",
            Size = UDim2.new(1, -180, 0, 20),
            Position = UDim2.new(0, 80, 0, 35),
            Text = "ID: " .. assetId,
            TextColor3 = colors.textMuted,
            TextSize = 12,
        }, frame)

        task.spawn(function()
            local success, info = pcall(function() return MarketplaceService:GetProductInfo(assetId) end)
            if success and info then
                nameLabel.Text = info.Name
            else
                nameLabel.Text = "Emote #" .. assetId
            end
        end)

        local playBtn = UI.imageButton({
            Name = "PlayBtn",
            Size = UDim2.new(0, 25, 0, 25),
            Position = UDim2.new(1, -96, 0.5, -20),
            BackgroundColor3 = colors.primary,
            BackgroundTransparency = 1,
            Image = getIcon("play"),
            ImageColor3 = colors.text,
            CornerRadius = UDim.new(0, 8),
        }, frame)

        playBtn.MouseButton1Click:Connect(function()
            if playAnimation then
                playAnimation(assetId, nameLabel.Text)
            else
                return
            end
        end)

        playBtn.MouseEnter:Connect(function()
            playBtn.ImageColor3 = colors.textMuted
        end)

        playBtn.MouseLeave:Connect(function()
            playBtn.ImageColor3 = colors.text
        end)

        local favBtn = UI.imageButton({
            Name = "FavBtn",
            Size = UDim2.new(0, 25, 0, 25),
            Position = UDim2.new(1, -48, 0.5, -20),
            BackgroundColor3 = colors.surface2,
            BackgroundTransparency = 1,
            Image = getIcon("star"),
            ImageColor3 = colors.warning,
            CornerRadius = UDim.new(0, 8),
        }, frame)

        favBtn.MouseButton1Click:Connect(function()
            if favorites and saveData then
                table.insert(favorites, { id = assetId, name = nameLabel.Text })
                saveData()
                pcall(refreshFavorites)
            else
                return
            end
        end)

        favBtn.MouseEnter:Connect(function()
            favBtn.BackgroundTransparency = 0.85
            favBtn.BackgroundColor3 = colors.surface2
            favBtn.ImageColor3 = colors.text
        end)

        favBtn.MouseLeave:Connect(function()
            favBtn.BackgroundTransparency = 1
            favBtn.ImageColor3 = colors.warning
        end)
    end

    resultsContainer.Size = UDim2.new(1, 0, 0, #data.data * 88)
    resultsScroll.CanvasSize = UDim2.new(0, 0, 0, #data.data * 88 + 20)
    pageLabel.Text = tostring(currentPage)
    resultsScroll.CanvasPosition = Vector2.new(0, 0)
end

