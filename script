local draggingSpeed = false
local function updateSpeedFromPosition(mouseX)
    local trackPos = speedTrack.AbsolutePosition.X
    local trackSize = speedTrack.AbsoluteSize.X
    local relativePos = math.clamp((mouseX - trackPos) / trackSize, 0, 1)

    settings.speed = 0.5 + (relativePos * 2.5)
    speedBar.Size = UDim2.new(relativePos, 0, 1, 0)
    speedThumb.Position = UDim2.new(relativePos, -8, 0.5, -8)
    speedValueLabel.Text = string.format("%.1fx", settings.speed)

    if currentAnim and currentAnim.IsPlaying then
        currentAnim:AdjustSpeed(settings.speed)
    end
end

