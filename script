-- tabs system
local allTabs = {}
local activeTab = nil

local function selectTabCore(targetPanel, targetButton, targetIcon)
    if activeTab then
        activeTab.button.BackgroundTransparency = 1
        activeTab.button.TextColor3 = colors.textMuted
        activeTab.icon.ImageColor3 = colors.textMuted
        activeTab.panel.Visible = false
    end
    targetButton.BackgroundTransparency = 0.2
    targetButton.TextColor3 = colors.text
    targetIcon.ImageColor3 = colors.text
    targetPanel.Visible = true
    for _, tab in ipairs(allTabs) do
        if tab.panel == targetPanel then
            activeTab = tab
            break
        end
    end
end

function newTab(args)
    args = args or {}
    local name = args.name or "Tab"
    local iconName = args.icon or "circle"
    local layoutOrder = args.order or #allTabs + 1

    -- panels tabs content 
    local panel = UI.frame({
        Name = name .. "Panel",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        CornerRadius = UDim.new(0, 0),
        Visible = false,
    }, contentAreaFrame)

    -- tab buttonContainer
    local button = UI.button({
        Name = name .. "Tab",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = colors.surface2,
        BackgroundTransparency = 1,
        Text = "               " .. name,
        TextColor3 = colors.textMuted,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        CornerRadius = UDim.new(0, 10),
        LayoutOrder = layoutOrder,
        AutoButtonColor = false,
    }, tabContainer)

    -- Icon 
    local icon = UI.icon(iconName, 18, {
        Name = "Icon",
        Position = UDim2.new(0, 14, 0.5, -9),
        ImageColor3 = colors.textMuted,
    }, button)

    button.MouseEnter:Connect(function()
        if activeTab and activeTab.button == button then return end
        button.BackgroundTransparency = 0.5
        button.TextColor3 = colors.text
        icon.ImageColor3 = colors.text
    end)

    button.MouseLeave:Connect(function()
        if activeTab and activeTab.button == button then return end
        button.BackgroundTransparency = 1
        button.TextColor3 = colors.textMuted
        icon.ImageColor3 = colors.textMuted
    end)

    button.MouseButton1Click:Connect(function()
        selectTab(panel, button, icon)
    end)

    local tab = {
        name = name,
        panel = panel,
        button = button,
        icon = icon,
    }
    table.insert(allTabs, tab)

    if #allTabs == 1 then
        selectTabCore(panel, button, icon)
    end

    return panel
end


