-- Close
local function closeUI()

    if KMinimize then KMinimize:Disconnect() end

    if ListenMinimizeBind then ListenMinimizeBind:Disconnect() end

    if positionChangedListen then positionChangedListen:Disconnect() end

    if speedListen then speedListen:Disconnect() end

    if speedEndListen then speedEndListen:Disconnect() end

    if floatChangeListen then floatChangeListen:Disconnect() end

    if floatEndListen then floatEndListen:Disconnect() end

    if resetWalkSOnRespawn then resetWalkSOnRespawn:Disconnect() end

    if playersAddedListen then playersAddedListen:Disconnect() end

    if playersRemovingListen then playersRemovingListen:Disconnect() end

    if spectating then stopSpectating() end
    
    if minimizeHandler then minimizeHandler:Disconnect() end

    if openHandler then openHandler:Disconnect() end

    if currentAnim and currentAnim.IsPlaying then
        currentAnim:Stop()
    end
    
    if player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
        player.Character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
    end

    if isWalking then
        isWalking = false
    end
    
    if isMinimized then
        toggleMinimize()
    end

    if listeningKey then
        listeningKey = false
    end

    if isDragging then
        isDragging = false
    end

    if isFloatingDragging then
        isFloatingDragging = false
    end

    if dragConnection1 then
        dragConnection1:Disconnect()
    end
    if dragConnection2 then
        dragConnection2:Disconnect()
    end
    if dragConnection3 then
        dragConnection3:Disconnect()
    end
    local closeTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 1,
        })
    closeTween:Play()
    closeTween.Completed:Connect(function()
        if screenGui then
            screenGui:Destroy()
        end
    end)
end
closeBtn.MouseButton1Click:Connect(closeUI)

showNotification("REV Emotes loaded successfully", "success")
