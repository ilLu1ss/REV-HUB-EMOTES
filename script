-- floating menu drag logic

local isFloatingDragging = false
local floatDragStart = nil
local floatStartPos = nil

dragArea.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
        input.UserInputType == Enum.UserInputType.Touch then
        isFloatingDragging = true
        floatDragStart = Vector2.new(input.Position.X, input.Position.Y)
        floatStartPos = Vector2.new(floatingContainer.AbsolutePosition.X, floatingContainer.AbsolutePosition.Y)
    end
end)

local floatChangeListen = UserInputService.InputChanged:Connect(function(input)
    if isFloatingDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch) then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - floatDragStart
        local newPos = floatStartPos + delta
        floatingContainer.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
    end
end)

local floatEndListen = UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
        input.UserInputType == Enum.UserInputType.Touch then
        isFloatingDragging = false
    end
end)


-- minimize 
local isMinimized = false
local lastMainFramePos = nil 

function toggleMinimize()
    isMinimized = not isMinimized

    if isMinimized then
        lastMainFramePos = mainFrame.Position

        local minimizeTween = TweenService:Create(mainFrame,
            TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1,
            })
        minimizeTween:Play()

        task.delay(0.3, function()
            mainFrame.Visible = false
            contentAreaFrame.Visible = false
            tabContainer.Visible = false
            floatingContainer.Visible = true
        end)
    else
        floatingContainer.Visible = false
        mainFrame.Visible = true
        mainFrame.Size = UDim2.new(0, 0, 0, 0)
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0) 
        mainFrame.BackgroundTransparency = 1

        contentAreaFrame.Visible = true
        tabContainer.Visible = true

        local restoreTween = TweenService:Create(mainFrame,
            TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 590, 0, 480),
                Position = lastMainFramePos or UDim2.new(0.5, -590 / 2, 0.5, -480 / 2),
                BackgroundTransparency = 0,
            })
        restoreTween:Play()
    end
end

