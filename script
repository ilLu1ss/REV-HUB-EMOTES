-- emotes logic

local currentAnim = nil

local function anim2track(asset_id)
    local objs = game:GetObjects(asset_id)
    for i = 1, #objs do
        if objs[i]:IsA("Animation") then
            return objs[i].AnimationId
        end
    end
    return asset_id
end

local function playAnimation(assetId, customName)
    if not player.Character then return false end
    local humanoid = player.Character:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return false end

    if currentAnim and currentAnim.IsPlaying then
        currentAnim:Stop()
    end

    if not assetId or type(assetId) ~= "number" then
        showNotification("ID invalido", "error")
        return false
    end

    local animId = "rbxassetid://" .. assetId
    local finalId = anim2track(animId)

    local animation = Instance.new("Animation")
    animation.AnimationId = finalId

    local success, anim = pcall(function()
        return humanoid:LoadAnimation(animation)
    end)

    if not success or not anim then
        showNotification("The emote could not be loaded", "error")
        return false
    end

    anim.Priority = Enum.AnimationPriority.Movement
    anim:Play()
    if settings.speed ~= 1.0 then
        anim:AdjustSpeed(settings.speed)
    end
    currentAnim = anim
    showNotification("Playing: " .. (customName or "ID " .. assetId), "playing")
    return true
end

local function stopAnimation()
    if currentAnim and currentAnim.IsPlaying then
        currentAnim:Stop()
        currentAnim = nil
    end
end

-- cancel emote on move 
local CancelMoved = {}
local function stopAnimOnMove(character)
    for _, conn in ipairs(CancelMoved) do
        conn:Disconnect()
    end
    CancelMoved = {}

    local humanoid = character:WaitForChild("Humanoid")

    local runConn = humanoid.Running:Connect(function(speed)
        if not settings.cancelOnMove then return end
        if speed > 0.1 and currentAnim and currentAnim.IsPlaying then
            stopAnimation()
        end
    end)
    table.insert(CancelMoved, runConn)

    local jumpConn = humanoid.Jumping:Connect(function()
        if not settings.cancelOnMove then return end
        if currentAnim and currentAnim.IsPlaying then
            stopAnimation()
        end
    end)
    table.insert(CancelMoved, jumpConn)

    local stateConn = humanoid.StateChanged:Connect(function(oldState, newState)
        if not settings.cancelOnMove then return end

        local moveStates = {
            [Enum.HumanoidStateType.Running] = true,
            [Enum.HumanoidStateType.RunningNoPhysics] = true,
            [Enum.HumanoidStateType.Jumping] = true,
            [Enum.HumanoidStateType.Climbing] = true,
            [Enum.HumanoidStateType.GettingUp] = true,
            [Enum.HumanoidStateType.Swimming] = true,
        }

        if moveStates[newState] and currentAnim and currentAnim.IsPlaying then
            stopAnimation()
        end
    end)
    table.insert(CancelMoved, stateConn)
end

if player.Character then
    stopAnimOnMove(player.Character)
end
local cancelOnmoveListen = player.CharacterAdded:Connect(stopAnimOnMove)


