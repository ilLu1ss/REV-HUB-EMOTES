local function prettyJSON(data, indent)
    indent = indent or 0
    local spaces = string.rep("  ", indent)
    local result = ""

    if type(data) == "table" then
        local isArray = true
        local maxIndex = 0
        for k, _ in pairs(data) do
            if type(k) == "number" then
                if k > maxIndex then maxIndex = k end
            else
                isArray = false
                break
            end
        end
        if isArray then
            for i = 1, maxIndex do
                if data[i] == nil then
                    isArray = false
                    break
                end
            end
        end

        if isArray then
            result = result .. "[\n"
            for i, v in ipairs(data) do
                result = result .. spaces .. "  " .. prettyJSON(v, indent + 1)
                if i < #data then result = result .. "," end
                result = result .. "\n"
            end
            result = result .. spaces .. "]"
        else
            result = result .. "{\n"
            local keys = {}
            for k in pairs(data) do table.insert(keys, k) end
            table.sort(keys)
            for i, k in ipairs(keys) do
                local v = data[k]
                result = result .. spaces .. "  " .. string.format("%q", k) .. ": " .. prettyJSON(v, indent + 1)
                if i < #keys then result = result .. "," end
                result = result .. "\n"
            end
            result = result .. spaces .. "}"
        end
    elseif type(data) == "string" then
        result = result .. string.format("%q", data)
    else
        result = result .. tostring(data)
    end
    return result
end

local function ensureFolder()
    if not makefolder or not isfolder then return false end
    if not isfolder("rev-hub") then
        makefolder("rev-hub")
    end
    return true
end

function saveData()
    if not writefile then
        return
    end
    if not ensureFolder() then return end

    local data = { favorites = favorites, settings = settings }
    local success, err = pcall(function()
        writefile(dataFile, prettyJSON(data))
    end)

    if success then
        showNotification("Data saved", "saved")
    else
        showNotification("Save failed", "error")
    end
end

function loadData()
    if not readfile or not isfile then return end
    if not isfile(dataFile) then return end

    local success, raw = pcall(readfile, dataFile)
    if not success or not raw then
        showNotification("Error reading data", "warning")
        return
    end

    local decodeSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)

    if decodeSuccess and decoded then
        favorites = decoded.favorites or {}
        if type(decoded.settings) == "table" then
            for k, v in pairs(decoded.settings) do
                settings[k] = v
            end
        end
    else
        favorites = {}
    end
end

